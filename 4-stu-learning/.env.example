# 高德 Web JS API 浏览器端配置
VITE_AMAP_KEY=replace_with_your_amap_key
VITE_AMAP_SECURITY_CODE=replace_with_your_security_code
VITE_AMAP_STYLE=amap://styles/normal

# Node 智能体服务（OPENAI_* 只在服务端读取）
APP_ENV=local
AI_ENABLED=true
REALTIME_MODE=polling
EVIDENCE_UPLOAD_MODE=proxy
ENABLE_DEMO=true
READINESS_TOKEN=replace_with_at_least_24_random_characters
OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
OPENAI_API_KEY=replace_with_your_server_key
OPENAI_MODEL=replace_with_your_model
# 语义理解（每个自由文字回合的第一段）用的小模型。留空则复用 OPENAI_MODEL。
# OPENAI_UNDERSTAND_MODEL=replace_with_a_smaller_model
# 小模型可以住在另一个服务商。下面三项留空则沿用主模型那套地址与密钥；
# 一旦 BASE_URL 指向别家，就必须同时给 API_KEY，否则启动即失败（不留到运行期 401）。
# OPENAI_UNDERSTAND_BASE_URL=https://api.deepseek.com/v1
# OPENAI_UNDERSTAND_API_KEY=replace_with_that_provider_key
# OPENAI_UNDERSTAND_WIRE_API=chat_completions
OPENAI_WIRE_API=chat_completions
AI_TOOL_MODE=auto
# 当前未实现：services/llm.js 硬编码 webSearch: false；接线前配置它没有效果。
AI_WEB_SEARCH_MODE=auto
AI_VISION_MODE=auto
AI_REASONING_EFFORT=minimal
AI_MAX_OUTPUT_TOKENS=192
AI_TIMEOUT_MS=18000
AI_UNDERSTAND_TIMEOUT_MS=8000
AI_TURN_TIMEOUT_MS=70000
AI_REQUEST_LEASE_MS=80000
HOST=127.0.0.1
PORT=3000
SESSION_STORE_DIR=.runtime
# Vercel 运行时使用 Supabase transaction pooler（端口 6543）；本地无数据库时保持注释
# DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres
DB_POOL_MAX=2
DB_CONNECTION_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=8000
DB_IDLE_TIMEOUT_MS=10000
DB_MAX_LIFETIME_SECONDS=300

# Supabase Storage S3 server-only 配置；Preview/Production 不会回退到本地 uploads/
S3_BUCKET=study-evidence
S3_REGION=auto
S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=replace_with_access_key
S3_SECRET_ACCESS_KEY=replace_with_secret_key
S3_PREFIX=evidence
MAX_UPLOAD_BYTES=4000000

# 浏览器通过 Vite 代理访问本地服务
VITE_API_BASE_URL=/api
