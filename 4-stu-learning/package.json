{
  "name": "forbidden-city-study-learning",
  "version": "1.0.0",
  "private": true,
  "description": "故宫治水研学学生端前端项目",
  "type": "module",
  "scripts": {
    "sync:lessons": "node scripts/sync-lessons.mjs",
    "lint:lesson": "node scripts/lint-lesson.mjs",
    "predev": "npm run sync:lessons",
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node server/index.js",
    "dev:api:watch": "node --watch-path=server server/index.js",
    "dev:web": "vite --host 0.0.0.0",
    "prebuild": "npm run sync:lessons",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:ai-eval": "node --test tests/ai-dialogue-corpus.test.js tests/ai-dialogue-eval.test.js tests/ai-dialogue-runner.test.js tests/ai-dialogue-artifact.test.js tests/ai-dialogue-review.test.js tests/ai-dialogue-gate-scripts.test.js",
    "eval:ai:live": "AI_DIALOGUE_PROFILE=diagnostic AI_DIALOGUE_REPETITIONS=1 node scripts/run-ai-dialogue-eval.mjs",
    "eval:ai:diagnostic": "npm run eval:ai:live",
    "eval:ai:formal": "AI_DIALOGUE_PROFILE=release AI_DIALOGUE_REPETITIONS=3 node scripts/run-ai-dialogue-eval.mjs",
    "eval:ai:review": "node scripts/verify-ai-dialogue-review.mjs",
    "quality:gate": "npm run lint:lesson -- --strict && npm test && npm run build",
    "quality:gate:release": "npm run quality:gate",
    "quality:gate:formal:live": "npm run quality:gate && npm run eval:ai:formal",
    "quality:gate:formal": "npm run quality:gate && npm run eval:ai:review"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1091.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.3.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.11.0",
    "lucide": "^1.25.0",
    "pg": "^8.22.0",
    "zod": "^3.25.76"
  }
}
